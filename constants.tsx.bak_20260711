export const SHARED_TOC_ITEMS = [
    {
        id: 'overall-top',
        title: '🏠 【全体表示】総合レポート',
        level: 1,
        path: '/'
    },
    ...reportData.sections.map((section, index) => {
        const id = `section-${index}`;
        let path = undefined;
        
        // Map every single section to its detail page
        if (section.title.includes('最新の数理予測モデル')) path = '/analysis/simulation-model/';
        else if (section.title.includes('解説動画')) path = '/analysis/video-guide/';
        else if (section.title.includes('視覚的証拠')) path = '/analysis/statistical-evidence/';
        else if (section.title.includes('リスク分析')) path = '/analysis/risk-analysis/';
        else if (section.title.includes('経済への長期的影響')) path = '/analysis/economic-impact/';
        else if (section.title.includes('財政影響分析')) path = '/analysis/economic-impact/';
        else if (section.title.includes('犯罪統計')) path = '/analysis/crime-statistics/';
        else if (section.title.includes('国家安全保障')) path = '/analysis/national-security/';
        else if (section.title.includes('国土・重要インフラ')) path = '/analysis/land-acquisition/';
        else if (section.title.includes('なし崩し的')) path = '/analysis/uk-immigration-lesson/';
        else if (section.title.includes('働き方改革')) path = '/analysis/labor-dilemma/';
        else if (section.title.includes('緑町住宅')) path = '/analysis/symbiosis/';
        else if (section.title.includes('ナイジェリア')) path = '/analysis/nigeria-case/';
        else if (section.title.includes('人手不足')) path = '/analysis/labor-mismatch/';
        else if (section.title.includes('総括')) path = '/analysis/summary-statistics/';
        else if (section.title.includes('政策提言')) path = '/analysis/policy-recommendations/';
        else if (section.title.includes('結び')) path = '/analysis/conclusion/';
        else if (section.title.includes('実証データ')) path = '/analysis/borderless-welfare-state/';
        
        return {
            id,
            title: section.title,
            level: 1,
            path
        };
    }),
    {
        id: 'strategic-recommendations',
        title: '戦略的提言：日本の未来を守るために',
        level: 1,
        path: '/analysis/strategic-recommendations/'
    }
];

